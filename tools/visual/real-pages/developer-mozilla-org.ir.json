{
  "components": {
    "mdn-search-button": {
      "properties": {
        "align-items": "center",
        "background-color": "initial #18191b)",
        "border": "1px solid initial #51565d)",
        "border-radius": "9999px",
        "color": "initial #fff)",
        "cursor": "pointer",
        "display": "flex",
        "justify-content": "space-between",
        "margin": "0",
        "padding": ".25rem .25rem .25rem .75rem",
        "width": "5rem"
      }
    },
    "color-theme__button": {
      "properties": {
        "align-items": "center",
        "background-color": "initial",
        "border": "none",
        "color": "inherit",
        "column-gap": ".25rem",
        "cursor": "pointer",
        "display": "flex",
        "font": "inherit",
        "margin": "0",
        "padding": "0 .5rem"
      }
    },
    "color-theme__dropdown": {
      "properties": {
        "border": "1px solid initial #51565d)",
        "padding": ".75rem",
        "position": "absolute",
        "right": "0",
        "z-index": "1"
      }
    },
    "color-theme__option": {
      "properties": {
        "align-items": "center",
        "background-color": "initial",
        "border": "none",
        "color": "initial #fff)",
        "column-gap": ".25rem",
        "cursor": "pointer",
        "display": "flex",
        "font": "inherit",
        "margin": "0",
        "padding": ".25rem",
        "width": "100%"
      }
    },
    "language-switcher__button": {
      "properties": {
        "align-items": "center",
        "background-color": "initial",
        "border": "none",
        "color": "inherit",
        "column-gap": ".25rem",
        "cursor": "pointer",
        "display": "flex",
        "font": "inherit",
        "margin": "0",
        "padding": "0 .5rem"
      }
    },
    "language-switcher__dropdown": {
      "properties": {
        "background-color": "initial #212426)",
        "border": "1px solid initial #51565d)",
        "margin": "0",
        "padding": ".75rem",
        "position": "absolute",
        "right": "0",
        "width": "max-content",
        "z-index": "1"
      }
    },
    "language_switcher__remember": {
      "properties": {
        "border-bottom": "1px solid initial #51565d)",
        "display": "flex",
        "font-size": "0.8rem",
        "place-items": "center",
        "width": "100%"
      }
    },
    "language-switcher__list": {
      "properties": {
        "background-color": "initial #212426)",
        "list-style": "none",
        "margin": "0",
        "padding": "0",
        "width": "100%"
      }
    },
    "language-switcher__option": {
      "properties": {
        "align-items": "center",
        "background-color": "initial",
        "border": "none",
        "color": "initial #fff)",
        "column-gap": ".25rem",
        "display": "flex",
        "font": "inherit",
        "margin": "0",
        "padding": ".25rem",
        "-webkit-text-decoration": "none",
        "text-decoration": "none",
        "width": "100%"
      }
    },
    "switch__input": {
      "properties": {
        "appearance": "none",
        "background-color": "initial #c3c7cb)",
        "background-image": "radial-gradient(circle at calc(var(--switch-size)/2),initial #212426) calc((var(--switch-size)/2)*.8),#0000 calc((var(--switch-size)/2)*.8 + 1px))",
        "background-position": "var(--switch-position) 0",
        "background-repeat": "no-repeat",
        "background-size": "var(--switch-size)",
        "border-radius": "9999px",
        "display": "inline-block",
        "height": "var(--switch-size)",
        "margin": "0",
        "transition": "--switch-position .2s",
        "width": "calc(var(--switch-size)*1.6)"
      }
    },
    "button": {
      "properties": {
        "align-items": "center",
        "background-color": "initial",
        "border": "1px solid #0000",
        "border-radius": ".25rem",
        "color": "initial #fff)",
        "column-gap": ".3125em",
        "cursor": "pointer",
        "display": "inline-flex",
        "font-family": "\"Inter\",sans-serif",
        "font-size": ".875em",
        "font-weight": "450",
        "justify-content": "center",
        "line-height": "1",
        "margin": "0",
        "padding": ".5em",
        "-webkit-text-decoration": "none",
        "text-decoration": "none",
        "vertical-align": "middle"
      }
    },
    "mdn-homepage-search": {
      "properties": {
        "align-items": "center",
        "background-color": "initial",
        "border": "2px solid initial #51565d)",
        "border-radius": "9999px",
        "display": "flex",
        "font-size": "1.5rem",
        "gap": ".25em",
        "margin": "0 auto",
        "padding": ".8em 1em"
      }
    },
    "page-not-created": {
      "properties": {
        "color": "initial #fc7d92)",
        "text-decoration": "underline wavy",
        "-webkit-text-decoration": "underline wavy"
      }
    },
    "visually-hidden": {
      "properties": {
        "border": "0",
        "clip-path": "inset(50%)",
        "height": "1px",
        "margin": "-1px",
        "overflow": "hidden",
        "padding": "0",
        "position": "absolute",
        "white-space": "nowrap",
        "width": "1px"
      }
    },
    "homepage--dark": {
      "properties": {
        "color": "initial #fff)",
        "background-color": "initial #212426)",
        "color-scheme": "dark"
      }
    },
    "featured-articles__article": {
      "properties": {
        "border": "1px solid initial #51565d)",
        "border-radius": ".5rem",
        "display": "flex",
        "flex-direction": "column",
        "padding": "1rem"
      }
    },
    "latest-news__item": {
      "properties": {
        "border": "1px solid initial #51565d)",
        "border-radius": ".5rem",
        "display": "grid",
        "grid-template-areas": "\"source date\" \"title title\" \"summary summary\"",
        "grid-template-columns": "1fr max-content",
        "justify-content": "space-between",
        "padding": "1rem"
      }
    },
    "recent-contributions": {
      "properties": {
        "border": "1px solid initial #51565d)",
        "border-radius": ".5rem",
        "padding-left": "0"
      }
    },
    "recent-contributions__date": {
      "properties": {
        "color": "initial #c3c7cb)",
        "font-size": "0.8rem",
        "grid-area": "date"
      }
    }
  }
}