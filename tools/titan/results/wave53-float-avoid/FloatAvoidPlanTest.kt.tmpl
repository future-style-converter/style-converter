class FloatAvoidPlanTest {

    // Decode + slot-compose exactly like the capture screens (FloatClearanceWireTest's idiom).
    private fun roots(doc: String): List<IRComponent> = SlotComposer.compose(IRDocumentDecoder.decode(doc))

    // Every component of a composed tree, depth-first — every one is a candidate container.
    private fun all(c: IRComponent): List<IRComponent> = listOf(c) + c.children.orEmpty().flatMap(::all)

    // The shape of composed root [root] (root 0 of the contain tests is the instruction <p>).
    private fun shape(doc: String, root: Int): FloatAvoidShape =
        FloatAvoidPlan.shape(roots(doc)[root]).also { assertNotNull("the gate must admit this carrier", it) }!!

    // Solve with the wire's own float sizes, h injected, CSS px (scale 1).
    private fun solve(doc: String, root: Int, h: Double, incoming: Double = 400.0): FloatAvoidPlacement =
        shape(doc, root).let { FloatAvoidPlan.place(it, it.floatWidthsPx, it.floatHeightsPx, incoming, h) }

    // (x, y) of child [i] as a pair, for one-line assertions.
    private fun FloatAvoidPlacement.at(i: Int) = x[i] to y[i]

    // A derived payload: one exact substring edit of a verbatim literal (asserted to apply once).
    private fun derive(doc: String, old: String, new: String): String =
        doc.also { assertEquals("edit must match exactly once: $old", 1, it.split(old).size - 1) }.replace(old, new)

    private fun sha1(s: String): String =
        MessageDigest.getInstance("SHA-1").digest(s.toByteArray()).joinToString("") { "%02x".format(it) }

    @Test
    fun `verbatim - every literal hashes to its wave52-ship file`() {
        // The corpus files are one JSON line plus "\n"; the literal is the line.
        listOf(P001 to P001_SHA1, P002 to P002_SHA1, PFR2 to PFR2_SHA1, PFR1 to PFR1_SHA1, PNFC to PNFC_SHA1,
            PBFC3 to PBFC3_SHA1, PCC1 to PCC1_SHA1, PDU1 to PDU1_SHA1).forEach { (doc, h) -> assertEquals(h, sha1(doc + "\n")) }
    }

    @Test
    fun `P1 - 001 floats at 200,0 0,100 100,200 and the BFC beside float 3 at 0,200`() {
        // h = 170: the 20px line box + the 150px filler (brief §4.1).
        val p = solve(P001, 1, 170.0)
        assertEquals(listOf(200.0 to 0.0, 0.0 to 100.0, 100.0 to 200.0, 0.0 to 200.0), (0..3).map { p.at(it) })
    }

    @Test
    fun `P2 - 002 the 20px BFC fits beside float 1 at 0,0`() {
        assertEquals(0.0 to 0.0, solve(P002, 1, 20.0).at(3))
    }

    @Test
    fun `P3 - flow-root-002 floats at 150,0 and 0,100, the zero-width BFC at 250,100`() {
        val p = solve(PFR2, 0, 200.0)
        assertEquals(listOf(150.0 to 0.0, 0.0 to 100.0, 250.0 to 100.0), (0..2).map { p.at(it) })
    }

    @Test
    fun `P4 - the half-open boundary on 001 - h 100 fits at 0,0 and h 101 drops to 0,200`() {
        // [0,100) does not touch float 2's [100,200); [0,101) does.
        assertEquals(0.0 to 0.0, solve(P001, 1, 100.0).at(3))
        assertEquals(0.0 to 200.0, solve(P001, 1, 101.0).at(3))
    }

    @Test
    fun `P5 - the refused float-then-BFC shapes are null on every component`() {
        // display-flow-root-001 (span BFC with text), adjoining-float-new-fc and floats-bfc-003 (Clear,
        // margins, same-side run), contain-content-001 (root-level float), direction-upright-001 (Clear, runs).
        for (doc in listOf(PFR1, PNFC, PBFC3, PCC1, PDU1)) {
            roots(doc).flatMap(::all).forEach { assertNull("admitted ${it.id}", FloatAvoidPlan.shape(it)) }
        }
    }

    // 001's BFC property run, the anchor of every derived edit below.
    private val bfc = """{"type":"Contain","data":["INLINE_SIZE"]},{"type":"Display","data":"FLOW_ROOT"},{"type":"Width","data":"fit-content"}"""

    // Each derived pin isolates ONE clause: a single edit of verbatim 001 that only that clause refuses.
    private fun refused(doc: String) = roots(doc).flatMap(::all).forEach { assertNull("admitted ${it.id}", FloatAvoidPlan.shape(it)) }

    @Test
    fun `P5d G5 - a Clear on the BFC makes it FloatClearance's shape`() =
        refused(derive(P001, bfc, "$bfc,{\"type\":\"Clear\",\"data\":\"LEFT\"}"))

    @Test
    fun `P5d G7 - an auto width is the unprovable gap fill`() =
        refused(derive(P001, bfc, bfc.replace(""",{"type":"Width","data":"fit-content"}""", "")))

    @Test
    fun `P5d G7 - fit-content without inline-size containment is the content width`() =
        refused(derive(P001, bfc, bfc.replace("""{"type":"Contain","data":["INLINE_SIZE"]},""", "")))

    @Test
    fun `P5d G8 - a contain-sized BFC background would paint over the floats in wire order`() =
        refused(derive(P001, bfc, "$bfc,{\"type\":\"BackgroundColor\",\"data\":{\"srgb\":{\"r\":1,\"g\":0,\"b\":0}}}"))

    @Test
    fun `P5d G2 - the same container nested in a non-BFC parent can see outside floats`() =
        refused(derive(P001, """"px":400}}]}""", """"px":400}}],"slot":{"parent":"wpt__css-contain__contain-inline-size-bfc-floats-001__0-100"}}"""))

    // wave53 fix pass (L4 skeptic should-fix 2): CSS 2.1 §9.7 — an absolute/fixed float computes to `float:
    // none`; the gate keeps only static/relative floats. Float 2 of verbatim 001 is the edited one.
    private val float2 = """{"type":"Float","data":"LEFT"}"""

    @Test
    fun `P5d G6 - an absolute or fixed float is no float - refused - a relative one stays admitted`() {
        for (pos in listOf("ABSOLUTE", "FIXED")) refused(derive(P001, float2, "$float2,{\"type\":\"Position\",\"data\":\"$pos\"}"))
        assertNotNull(FloatAvoidPlan.shape(roots(derive(P001, float2, "$float2,{\"type\":\"Position\",\"data\":\"RELATIVE\"}"))[1]))
    }

    @Test
    fun `P6 - reported heights are the BFC bottoms 370, 20, 300 - floats excluded`() {
        assertEquals(370.0, solve(P001, 1, 170.0).height, 0.0)
        assertEquals(20.0, solve(P002, 1, 20.0).height, 0.0)
        assertEquals(300.0, solve(PFR2, 0, 200.0).height, 0.0)
    }

    @Test
    fun `P7 - right floats are placed from the 400px container, not a 358 proposal`() {
        // The canvas proposes its 358px content width; the root declares 400.
        assertEquals(200.0, solve(P001, 1, 170.0, incoming = 358.0).x[0], 0.0)
        assertEquals(150.0, solve(PFR2, 0, 200.0, incoming = 358.0).x[0], 0.0)
    }

    @Test
    fun `P8 - containment is load-bearing - un-contained widths 200 and 300 land below every float`() {
        // The brief's M1 geometry: with the orange's own width as the used size, nothing fits beside.
        fun at(doc: String, w: Double, h: Double) = shape(doc, 1).copy(bfcInlineSizePx = w)
            .let { FloatAvoidPlan.place(it, it.floatWidthsPx, it.floatHeightsPx, 400.0, h).at(3) }
        assertEquals(0.0 to 300.0, at(P001, 200.0, 170.0))
        assertEquals(0.0 to 300.0, at(P002, 300.0, 20.0))
    }

    // wave53 fix pass (L4 skeptic should-fix 1): the adapter passes DEVICE px with scale = density. Every
    // output must be the CSS-px plan times the density — 2.75 is a common phone density, exact in binary.
    @Test
    fun `P9 - device px - the placement is the CSS-px placement times the density`() {
        val s = 2.75
        fun dev(sh: FloatAvoidShape, h: Double) =
            FloatAvoidPlan.place(sh, sh.floatWidthsPx.map { it * s }, sh.floatHeightsPx.map { it * s }, 358.0 * s, h * s, s)
        fun css(sh: FloatAvoidShape, h: Double) = FloatAvoidPlan.place(sh, sh.floatWidthsPx, sh.floatHeightsPx, 358.0, h)
        val verbatim = shape(P001, 1)
        // Verbatim 001: float 1 hugs the 1100-px (400 CSS px) container's right edge; the BFC sits at (0, 550).
        val p = dev(verbatim, 170.0)
        assertEquals(550.0, p.x[0], 1e-9)
        assertEquals(0.0 to 550.0, p.at(3))
        assertEquals(1100.0, p.width, 1e-9)
        // A derived px-width BFC (120 CSS px: wider than float 3's 100-px gap, so it lands below every float at
        // y300) makes the used-size scale load-bearing too: unscaled, 120 device px would fit at y550.
        val wide = verbatim.copy(bfcInlineSizePx = 120.0)
        assertEquals(0.0 to 825.0, dev(wide, 170.0).at(3))
        for (sh in listOf(verbatim, wide)) {
            val d = dev(sh, 170.0); val c = css(sh, 170.0)
            assertEquals(c.x.map { it * s }, d.x); assertEquals(c.y.map { it * s }, d.y)
            assertEquals(c.width * s, d.width, 1e-9); assertEquals(c.height * s, d.height, 1e-9)
        }
    }

    // wave53 fix pass (L4 skeptic should-fix 4): the census runs the renderer-entry rewrite first — every
    // component the renderer composes is ContentsUnboxing.resolve(raw), whose child list has any
    // `display: contents` children spliced in (ComponentRenderer.kt RenderComponent), so a contents wrapper
    // around a float-then-BFC list is seen here exactly as the block loop sees it.
    private fun resolved(c: IRComponent): List<IRComponent> =
        com.styleconverter.runtime.core.renderer.ContentsUnboxing.resolve(c).let { r -> listOf(r) + r.children.orEmpty().flatMap(::resolved) }

    @Test
    fun `census - exactly the three carriers over all wave52-ship documents`() {
        // Local-only (tools/titan/runs/ is gitignored): skipped where the corpus is absent.
        var dir: File? = File(System.getProperty("user.dir") ?: ".").absoluteFile
        val rel = "tools/titan/runs/wave52-ship/sections"
        while (dir != null && !File(dir, rel).isDirectory) dir = dir.parentFile
        assumeTrue("wave52-ship corpus not present", dir != null)
        val files = File(dir, rel).listFiles().orEmpty().flatMap { File(it, "per-test-ir").listFiles().orEmpty().toList() }
            .filter { it.name.endsWith(".json") }.sortedBy { it.path }
        val hits = mutableListOf<String>()
        var components = 0
        for (f in files) {
            val rs = roots(f.readText())
            rs.forEachIndexed { ri, r ->
                resolved(r).forEach { c ->
                    components++
                    if (FloatAvoidPlan.shape(c) == null) return@forEach
                    hits += "${f.name}#${c.id}"
                    // Corpus facts G2 relies on: no EARLIER root carries a Float, and the container is the last root.
                    assertEquals("earlier-root float before ${c.id}", 0, rs.take(ri).flatMap(::all).count { x -> x.properties.any { it.type == "Float" } })
                    assertEquals("a root follows ${c.id}", rs.size - 1, ri)
                }
            }
        }
        println("FloatAvoid census: ${files.size} documents, $components components, ${hits.size} admitted: $hits")
        assertEquals(1435, files.size)
        assertEquals(listOf(
            "wpt__css-contain__contain-inline-size-bfc-floats-001.json#wpt__css-contain__contain-inline-size-bfc-floats-001__1-101",
            "wpt__css-contain__contain-inline-size-bfc-floats-002.json#wpt__css-contain__contain-inline-size-bfc-floats-002__1-109",
            "wpt__css-display__display-flow-root-002.json#wpt__css-display__display-flow-root-002__0-291",
        ), hits.sorted())
    }

