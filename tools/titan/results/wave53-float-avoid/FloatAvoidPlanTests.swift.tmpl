import CryptoKit
import XCTest
@testable import StyleConverterRuntime

final class FloatAvoidPlanTests: XCTestCase {

    /// Decode through the production reader (which slot-composes) — FloatClearanceWireTests' idiom.
    private func roots(_ doc: String) throws -> [IRComponent] {
        try JSONDecoder().decode(IRDocument.self, from: Data(doc.utf8)).components
    }

    /// Every component of a composed tree, depth-first — every one is a candidate container.
    private func all(_ c: IRComponent) -> [IRComponent] { [c] + (c.children ?? []).flatMap(all) }

    /// The admitted shape of composed root `root` (root 0 of the contain tests is the instruction <p>).
    private func shape(_ doc: String, _ root: Int) throws -> FloatAvoidPlan.Shape {
        try XCTUnwrap(FloatAvoidPlan.shape(try roots(doc)[root]), "the gate must admit this carrier")
    }

    /// Solve with the wire's own float sizes, h injected, CSS px.
    private func solve(_ doc: String, _ root: Int, h: Double, incoming: Double = 400) throws -> FloatAvoidPlan.Placement {
        let s = try shape(doc, root)
        return FloatAvoidPlan.place(s, floatWidths: s.floatWidthsPx, floatHeights: s.floatHeightsPx,
                                    incomingWidth: incoming, bfcHeight: h)
    }

    /// (x, y) of every child, for one-line assertions.
    private func at(_ p: FloatAvoidPlan.Placement) -> [[Double]] { zip(p.x, p.y).map { [$0, $1] } }

    /// A derived payload: one exact substring edit of a verbatim literal (asserted to apply once).
    private func derive(_ doc: String, _ old: String, _ new: String) -> String {
        XCTAssertEqual(doc.components(separatedBy: old).count - 1, 1, "edit must match exactly once: \(old)")
        return doc.replacingOccurrences(of: old, with: new)
    }

    /// Null on every component of `doc`.
    private func refused(_ doc: String, file: StaticString = #filePath, line: UInt = #line) throws {
        for c in try roots(doc).flatMap(all) { XCTAssertNil(FloatAvoidPlan.shape(c), "admitted \(c.id)", file: file, line: line) }
    }

    /// 001's BFC property run, the anchor of every derived edit.
    private let bfc = #"{"type":"Contain","data":["INLINE_SIZE"]},{"type":"Display","data":"FLOW_ROOT"},{"type":"Width","data":"fit-content"}"#

    func testVerbatim() {
        // The corpus files are one JSON line plus "\n"; the literal is the line.
        for (doc, h) in [(Self.P001, Self.P001_SHA1), (Self.P002, Self.P002_SHA1), (Self.PFR2, Self.PFR2_SHA1),
                         (Self.PFR1, Self.PFR1_SHA1), (Self.PNFC, Self.PNFC_SHA1), (Self.PBFC3, Self.PBFC3_SHA1),
                         (Self.PCC1, Self.PCC1_SHA1), (Self.PDU1, Self.PDU1_SHA1)] {
            let digest = Insecure.SHA1.hash(data: Data((doc + "\n").utf8)).map { String(format: "%02x", $0) }.joined()
            XCTAssertEqual(digest, h)
        }
    }

    func testP1_001FloatsAndTheBfcBesideFloat3() throws {
        // h = 170: the 20px line box + the 150px filler (brief §4.1).
        XCTAssertEqual(at(try solve(Self.P001, 1, h: 170)), [[200, 0], [0, 100], [100, 200], [0, 200]])
    }

    func testP2_002TheBfcFitsBesideFloat1() throws {
        XCTAssertEqual(at(try solve(Self.P002, 1, h: 20))[3], [0, 0])
    }

    func testP3_FlowRoot002ZeroWidthBfcAt250x100() throws {
        XCTAssertEqual(at(try solve(Self.PFR2, 0, h: 200)), [[150, 0], [0, 100], [250, 100]])
    }

    func testP4_HalfOpenBoundaryOn001() throws {
        // [0,100) does not touch float 2's [100,200); [0,101) does.
        XCTAssertEqual(at(try solve(Self.P001, 1, h: 100))[3], [0, 0])
        XCTAssertEqual(at(try solve(Self.P001, 1, h: 101))[3], [0, 200])
    }

    func testP5_RefusedShapesAreNilOnEveryComponent() throws {
        // display-flow-root-001, adjoining-float-new-fc, floats-bfc-003, contain-content-001, direction-upright-001.
        for doc in [Self.PFR1, Self.PNFC, Self.PBFC3, Self.PCC1, Self.PDU1] { try refused(doc) }
    }

    func testP5d_G5_ClearOnTheBfc() throws {
        try refused(derive(Self.P001, bfc, bfc + #",{"type":"Clear","data":"LEFT"}"#))
    }

    func testP5d_G7_AutoWidth() throws {
        try refused(derive(Self.P001, bfc, bfc.replacingOccurrences(of: #",{"type":"Width","data":"fit-content"}"#, with: "")))
    }

    func testP5d_G7_FitContentWithoutContainment() throws {
        try refused(derive(Self.P001, bfc, bfc.replacingOccurrences(of: #"{"type":"Contain","data":["INLINE_SIZE"]},"#, with: "")))
    }

    func testP5d_G8_ContainSizedBfcBackground() throws {
        try refused(derive(Self.P001, bfc, bfc + #",{"type":"BackgroundColor","data":{"srgb":{"r":1,"g":0,"b":0}}}"#))
    }

    func testP5d_G2_NestedInANonBfcParent() throws {
        try refused(derive(Self.P001, #""px":400}}]}"#,
                           #""px":400}}],"slot":{"parent":"wpt__css-contain__contain-inline-size-bfc-floats-001__0-100"}}"#))
    }

    func testP6_ReportedHeightsAreTheBfcBottoms() throws {
        XCTAssertEqual(try solve(Self.P001, 1, h: 170).height, 370)
        XCTAssertEqual(try solve(Self.P002, 1, h: 20).height, 20)
        XCTAssertEqual(try solve(Self.PFR2, 0, h: 200).height, 300)
    }

    func testP7_RightFloatsFromThe400pxContainerNotA358Proposal() throws {
        XCTAssertEqual(try solve(Self.P001, 1, h: 170, incoming: 358).x[0], 200)
        XCTAssertEqual(try solve(Self.PFR2, 0, h: 200, incoming: 358).x[0], 150)
    }

    func testP8_ContainmentIsLoadBearing() throws {
        // The brief's M1 geometry: with the orange's own width as the used size, nothing fits beside.
        func bfcAt(_ doc: String, _ w: Double, _ h: Double) throws -> [Double] {
            var s = try shape(doc, 1); s.bfcInlineSizePx = w
            return at(FloatAvoidPlan.place(s, floatWidths: s.floatWidthsPx, floatHeights: s.floatHeightsPx,
                                           incomingWidth: 400, bfcHeight: h))[3]
        }
        XCTAssertEqual(try bfcAt(Self.P001, 200, 170), [0, 300])
        XCTAssertEqual(try bfcAt(Self.P002, 300, 20), [0, 300])
    }

    /// S-L4's Swift half: the planner runs in EVERY capture-mode block loop, so it must admit exactly the three
    /// carriers over the whole corpus — and not crash on any document. Local-only (tools/titan/runs/ is gitignored).
    func testCensusExactlyTheThreeCarriers() throws {
        var dir = URL(fileURLWithPath: #filePath).deletingLastPathComponent()
        let rel = "tools/titan/runs/wave52-ship/sections"
        while dir.path != "/" && !FileManager.default.fileExists(atPath: dir.appendingPathComponent(rel).path) {
            dir = dir.deletingLastPathComponent()
        }
        let sections = dir.appendingPathComponent(rel)
        try XCTSkipUnless(FileManager.default.fileExists(atPath: sections.path), "wave52-ship corpus not present")
        let fm = FileManager.default
        let files = try fm.contentsOfDirectory(atPath: sections.path).flatMap { sec -> [URL] in
            let d = sections.appendingPathComponent(sec).appendingPathComponent("per-test-ir")
            return ((try? fm.contentsOfDirectory(atPath: d.path)) ?? []).filter { $0.hasSuffix(".json") }.map { d.appendingPathComponent($0) }
        }
        var hits: [String] = [], components = 0
        for f in files {
            let rs = try roots(try String(contentsOf: f, encoding: .utf8))
            for (ri, r) in rs.enumerated() {
                for c in all(r) {
                    components += 1
                    guard FloatAvoidPlan.shape(c) != nil else { continue }
                    hits.append("\(f.lastPathComponent)#\(c.id)")
                    // Corpus facts G2 relies on: no EARLIER root carries a Float, and the container is the last root.
                    XCTAssertFalse(rs.prefix(ri).flatMap(all).contains { $0.properties.contains { $0.type == "Float" } })
                    XCTAssertEqual(ri, rs.count - 1, "a root follows \(c.id)")
                }
            }
        }
        print("FloatAvoid census (swift): \(files.count) documents, \(components) components, \(hits.count) admitted: \(hits.sorted())")
        XCTAssertEqual(files.count, 1435)
        XCTAssertEqual(hits.sorted(), [
            "wpt__css-contain__contain-inline-size-bfc-floats-001.json#wpt__css-contain__contain-inline-size-bfc-floats-001__1-101",
            "wpt__css-contain__contain-inline-size-bfc-floats-002.json#wpt__css-contain__contain-inline-size-bfc-floats-002__1-109",
            "wpt__css-display__display-flow-root-002.json#wpt__css-display__display-flow-root-002__0-291",
        ])
    }

