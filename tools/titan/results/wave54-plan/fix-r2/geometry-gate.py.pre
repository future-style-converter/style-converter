#!/usr/bin/env python3
# tools/titan/results/wave54-plan/geometry-gate.py — PLAN.md §6 R6 / revert rule 4 as one executable read-out.
#
# Why: wave 53 ran five geometry probes by hand at the probe and at the closing gate, and matched their lines against
# expectations.json by eye. Wave 54 has twelve probe scripts across seven lanes, and rule 4 must name the COMMIT a
# failing row reverts. This runner reads `lanes.*.geometryProbes` from expectations.json (generated by plan-build.py),
# runs each probe's command with the run id substituted, and, per expect key, prints one verdict:
#   PASS        the probe line for that key ends in the exact expected string (and contains its `contains` string);
#   FAIL        it does not;
#   UNMEASURED  the capture is MISSING (a section not in this run) or no line names the key — never a pass, never a fail.
# and one CLASS per key (fix r1, plan-skeptic S5 / M3):
#   GATING     a `gating` key: a FAIL reverts the unit it names (rule 4) — only keys of units still on the tree;
#   WITHDRAWN  a key `probe_decisions()` demoted because a unit it needs was reverted at a probe: printed, gates nothing
#              (R6 reads "every gating key of a unit still on the tree");
#   control    a non-gating key expected to PASS today and to keep passing (a must-not-move picture; a FAIL is loud and
#              is diagnosed through rules 5 / R4, it does not exit 1);
#   report     a non-gating key expected WRONG today (a MED / LOW target, listed in the probe's `report`): read and
#              labelled, never a trigger.
# A probe that exits non-zero failed its OWN ref self-check: the RULE is wrong, not the lane — reported as SELF-CHECK
# FAILED and the gate exits 1 (the wave-53 geometry_common contract). Pure subprocess + text; the probes decode PNGs.
#
# Usage: python3 tools/titan/results/wave54-plan/geometry-gate.py <run> [--base wave54-open] [--lanes L1,L4]
#        [--json out.json] [--exp expectations.json] [--self-test]
#   exit 1 on a GATING FAIL or a probe self-check failure; exit 2 when expectations.json is STALE (a gating key needs a
#   unit that probeDecisions lists as reverted: re-run plan-build.py).
#   --self-test (the lanes' build-workflow rule 5, on wave53-final --base wave53-open): exit 0 iff every GATING key
#   FAILs, every control PASSes and every report key FAILs — the rules can fail and the controls hold.
# Executed at planning (PLAN §6) and re-executed at the fix pass: wave53-final --base wave53-open fails every gating
# row while every control passes; wave53-probe --base wave53-open --lanes L1,L2 passes L1's [P] rows and [M] web/ios
# and fails [M] android and 006 android — the two units wave 53 reverted, named.
import json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, '..', '..', '..', '..'))
args = sys.argv[1:]
def opt(name, default=None):
    """Pop `--name value` from args (the run id is the one positional argument left)."""
    if name in args:
        i = args.index(name); val = args[i + 1]; del args[i:i + 2]; return val
    return default
def flag(name):
    """Pop a bare `--name` switch."""
    if name in args:
        args.remove(name); return True
    return False
base = opt('--base', 'wave54-open')
only = opt('--lanes')
json_out = opt('--json')
exp_path = opt('--exp', os.path.join(HERE, 'expectations.json'))   # a dry-run expectations.json (plan-build.py --out)
self_test = flag('--self-test')
if len(args) != 1:
    sys.exit('usage: geometry-gate.py <run> [--base wave54-open] [--lanes L1,L4] [--json out.json] [--exp file] [--self-test]')
run = args[0]
EXP = json.load(open(exp_path))
norm = lambda s: re.sub(r'\s+', ' ', s.strip())       # probes pad their columns with runs of spaces

# STALE guard (fix r1, M3): plan-build.py withdraws a reverted unit's gating keys; if a gating key still needs a unit
# that probeDecisions lists as reverted, the JSON was not regenerated — refuse rather than name a unit that is gone.
reverted = {(d['lane'], d['unit']) for d in ((EXP.get('probeDecisions') or {}).get('reverted') or [])}
stale = []
for lane_id, lane in EXP['lanes'].items():
    for probe in lane.get('geometryProbes', []):
        for key, spec in probe.get('gating', {}).items():
            needs = set(probe.get('requires', {}).get(key) or spec.split('|'))
            stale += [f'{lane_id} {key} needs {u}' for u in needs if (lane_id, u) in reverted]
if stale:
    print('STALE expectations.json — gating keys of reverted units (re-run plan-build.py):\n  ' + '\n  '.join(stale))
    sys.exit(2)

def find_line(lines, key):
    """The probe line naming `key`: its tokens appear contiguously within the first len(key)+2 tokens of the line
    (compose-table-body-cell.geometry.py prefixes the run id; every other probe starts with the key)."""
    kt = key.split()
    hits = []
    for l in lines:
        t = l.split()
        for i in range(0, min(3, max(0, len(t) - len(kt) + 1))):
            if t[i:i + len(kt)] == kt:
                hits.append(l); break
    return hits

report, gating_fail, selfcheck_fail = [], 0, 0
for lane_id, lane in EXP['lanes'].items():
    if only and not any(lane_id.startswith(x) for x in only.split(',')):
        continue
    for probe in lane.get('geometryProbes', []):
        cmd = probe['cmd'].replace('<run>', run).replace('<base>', base)
        proc = subprocess.run(['nice', '-n', '19'] + cmd.split(), cwd=ROOT, capture_output=True, text=True)
        lines = [norm(l) for l in proc.stdout.splitlines() if l.strip()]
        script = os.path.basename(cmd.split()[1])
        if proc.returncode != 0:
            selfcheck_fail += 1
            print(f'!! {lane_id} {script}: exit {proc.returncode} — SELF-CHECK FAILED (the rule, not the lane): {norm(proc.stderr)[-200:]}')
        report_keys = set(probe.get('report', []))
        for key, want in probe['expect'].items():
            hits = find_line(lines, key)
            gate_unit = probe.get('gating', {}).get(key)
            withdrawn = probe.get('withdrawn', {}).get(key)
            contains = probe.get('contains', {}).get(key, '').replace('<base>', base)
            if not hits or any('MISSING' in h for h in hits):
                verdict, line = 'UNMEASURED', (hits[-1] if hits else '(no line)')
            else:
                line = hits[-1]
                ok = line.endswith(norm(want)) and (not contains or contains in line)
                verdict = 'PASS' if ok else 'FAIL'
            cls = 'gating' if gate_unit else 'withdrawn' if withdrawn else 'report' if key in report_keys else 'control'
            if verdict == 'FAIL' and cls == 'gating':
                gating_fail += 1
            tag = {'gating': f'GATING -> revert {gate_unit}', 'withdrawn': f'WITHDRAWN ({withdrawn})',
                   'report': 'report: expected WRONG until the target is fixed', 'control': 'control: expected to stay PASS'}[cls]
            mark = {'PASS': '  ', 'FAIL': {'gating': '!!', 'control': '!c'}.get(cls, ' -'), 'UNMEASURED': ' ?'}[verdict]
            print(f'{mark} {lane_id:24} {script:42} {key:58} {verdict:10} [{tag}]')
            if verdict != 'PASS':
                print(f'     line: {line[-220:]}')
            report.append({'lane': lane_id, 'script': script, 'key': key, 'verdict': verdict, 'class': cls, 'gatingUnit': gate_unit,
                           'withdrawn': withdrawn, 'expected': want, 'contains': contains or None, 'line': line})

n = {v: sum(1 for r in report if r['verdict'] == v) for v in ('PASS', 'FAIL', 'UNMEASURED')}
by = lambda c, v: sum(1 for r in report if r['class'] == c and r['verdict'] == v)
print(f'\ngeometry-gate {run} (base {base}): {len(report)} keys — PASS {n["PASS"]} · FAIL {n["FAIL"]} '
      f'(gating {gating_fail}) · UNMEASURED {n["UNMEASURED"]} · probe self-check failures {selfcheck_fail}')
print('  by class: ' + ' · '.join(f'{c} {sum(1 for r in report if r["class"] == c)} (PASS {by(c, "PASS")} FAIL {by(c, "FAIL")})'
                                  for c in ('gating', 'control', 'report', 'withdrawn')))
units = sorted({r['gatingUnit'] for r in report if r['verdict'] == 'FAIL' and r['class'] == 'gating'})
if units:
    print('revert rule 4 names:', ', '.join(units))
bad_ctl = [r for r in report if r['class'] == 'control' and r['verdict'] == 'FAIL']
if bad_ctl:
    print(f'CONTROL FAILS ({len(bad_ctl)}) — a must-not-move picture moved; diagnose through rules 5 / R4:')
    for r in bad_ctl:
        print(f'   {r["lane"]} {r["script"]} {r["key"]}')
if json_out:
    json.dump({'run': run, 'base': base, 'rows': report, 'gatingFail': gating_fail, 'selfCheckFail': selfcheck_fail},
              open(json_out, 'w'), indent=1, ensure_ascii=False)
if self_test:
    # The rules can fail (every gating key FAILs on the pre-fix pictures), the controls hold, the report keys are honest.
    viol = [r for r in report if (r['class'] == 'gating' and r['verdict'] != 'FAIL') or (r['class'] == 'control' and r['verdict'] != 'PASS')
            or (r['class'] == 'report' and r['verdict'] != 'FAIL')]
    for r in viol:
        print(f'SELF-TEST VIOLATION {r["class"]} {r["verdict"]}: {r["lane"]} {r["script"]} {r["key"]}')
    print(f'self-test: {"HOLDS" if not viol and not selfcheck_fail else "FAILS"} — {len(viol)} violation(s), {selfcheck_fail} self-check failure(s)')
    sys.exit(0 if not viol and not selfcheck_fail else 1)
sys.exit(1 if gating_fail or selfcheck_fail else 0)
