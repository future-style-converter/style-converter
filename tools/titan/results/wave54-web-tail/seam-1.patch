+
+/** A per-test document over a component list. */
+const doc = (components: unknown[]): IRDocument =>
+  ({ irVersion: 2, minReaderVersion: 2, components }) as unknown as IRDocument;
+/** Render each root as its id token, so the interleaved array reads as data. */
+const ids = (r: ComposedNode): string => r.component.id;
+/** Separator positions: the index (in forest order) of the root each ' ' FOLLOWS. */
+const gapsAfter = (out: unknown[]): string[] =>
+  out.flatMap((x, i) => (x === ' ' ? [String(out[i - 1])] : []));
+/** Root-level separators in the gallery markup: a ' ' text node between two root <img>s. */
+const imgGaps = (html: string): number => (html.match(/\/> <img/g) ?? []).length;
+/** Root <img> elements in the gallery markup (20 on box-sizing-007). */
+const imgCount = (html: string): number => (html.match(/<img /g) ?? []).length;
+
+// Both read-once module constants on (the composed capture URL), then import
+// the modules that read them — the harness suites' stub-and-reimport pattern.
+let wsAfterSeparator: typeof import('../../src/sdui/ComponentRenderer').wsAfterSeparator;
+let ComponentRenderer: typeof import('../../src/sdui/ComponentRenderer').ComponentRenderer;
+let ComposedCaptureGallery: typeof import('../../src/ui/ComposedCaptureGallery').ComposedCaptureGallery;
+// The container styles exactly as the child walk hands them over (ctx.styles = buildStyles).
+let cssOf: (p: IRProperty[]) => { display?: unknown; whiteSpace?: unknown };
+beforeAll(async () => {
+  vi.stubGlobal('window', { location: { search: '?wpt=1&wptComposed=1' } });
+  vi.resetModules();
+  ({ wsAfterSeparator, ComponentRenderer } = await import('../../src/sdui/ComponentRenderer'));
+  ({ ComposedCaptureGallery } = await import('../../src/ui/ComposedCaptureGallery'));
+  const { buildStyles } = await import('@style-converter/web/core/renderer/StyleBuilder');
+  cssOf = (p) => buildStyles(p);
+}, 30000); // Generous timeout: cold vite import can hit ~15s.
+afterAll(() => { vi.unstubAllGlobals(); });
+
+/** The whole composed gallery for one per-test document (static markup). */
+const gallery = (components: unknown[]): string =>
+  renderToStaticMarkup(<ComposedCaptureGallery document={doc(components)} />);
+
+describe('root separators on verbatim box-sizing-007 (wave-54 L6 RS)', () => {
+  it('bs007_interleave_19Separators_noneAfterBodyRootOrP', () => {
+    const d = doc(BS007);
+    const roots = composeTree(d);
+    const out = interleaveRootSeparators(roots, ids, rootSeparatorContainer(d, null), wsAfterSeparator);
+    const gaps = gapsAfter(out);
+    // 20 root imgs → 19 inline-level marked pairs.
+    expect(gaps).toHaveLength(19);
+    // Neither block-level root (the body-root, the ws-after <p>) is followed by one.
+    expect(gaps).not.toContain('wpt__css-ui__box-sizing-007__0-290');
+    expect(gaps).not.toContain('wpt__css-ui__box-sizing-007__1-291');
+    // The last img (no marker) is never followed by one either (it is last).
+    expect(gaps).not.toContain('wpt__css-ui__box-sizing-007__21-311');
+  });
+
+  it('bs007_gallery_markupCarries19RootGaps', () => {
+    const html = gallery(BS007);
+    // All 20 atoms render; 19 real collapsed-space text nodes sit between them.
+    expect(imgCount(html)).toBe(20);
+    expect(imgGaps(html)).toBe(19);
+  });
+
+  it('bs007_gallery_flowWrapperSite_alsoSeparates', () => {
+    // A body margin routes the forest through the data-capture-flow wrapper
+    // (wave-52 L2 M1) — the SECOND call site; no corpus carrier takes it today.
+    const margined = BS007.map((c, i) => (i === 0
+      ? { ...c, properties: [...c.properties, { type: 'MarginLeft', data: { px: 8 } }] } : c));
+    const html = gallery(margined);
+    expect(html).toContain('data-capture-flow');
+    expect(imgGaps(html)).toBe(19);
+  });
+
+  it('flush_anUnmarkedPairStaysFlush_onVerbatimWire', () => {
+    // The anti-invention pin: strip the marker from img 6 (index 6, id …6-296);
+    // the source then had no whitespace between it and img 7 → no separator.
+    const flush = BS007.map((c, i) => (i === 6 ? { ...c, meta: { ...c.meta, role: undefined } } : c));
+    const d = doc(flush);
+    const gaps = gapsAfter(interleaveRootSeparators(composeTree(d), ids, rootSeparatorContainer(d, null), wsAfterSeparator));
+    expect(gaps).toHaveLength(18);
+    expect(gaps).not.toContain('wpt__css-ui__box-sizing-007__6-296');
+    // The gallery agrees.
+    expect(imgGaps(gallery(flush))).toBe(18);
+  });
+
+  it('tableBody_wrapperDeclines_inTheRealGallery', () => {
+    // The same roots under a `display: table` body (wave-53 CanvasTableBody plan).
+    const tableBody = BS007.map((c, i) => (i === 0
+      ? { ...c, properties: [...c.properties, { type: 'Display', data: 'TABLE' }] } : c));
+    const html = gallery(tableBody);
+    expect(html).toContain('display:table');
+    expect(imgGaps(html)).toBe(0);
+  });
+
+  it('preBody_declines_throughTheBodysWhiteSpace', () => {
+    // A white-space-preserving body: the ref keeps the source's newlines, not one space.
+    const preBody = BS007.map((c, i) => (i === 0
+      ? { ...c, properties: [...c.properties, { type: 'WhiteSpace', data: 'PRE' }] } : c));
+    expect(imgGaps(gallery(preBody))).toBe(0);
+  });
+});
+
+/** A v2 component with only what the predicate reads. */
+const comp = (id: string, properties: IRProperty[], meta: Record<string, unknown> = {}) =>
+  ({ id, name: id, properties, meta });
+/** A leaf ComposedNode. */
+const leaf = (c: ReturnType<typeof comp>): ComposedNode => ({ component: c, children: [] }) as unknown as ComposedNode;
+
+describe('call-equivalence: renderChildSeparator ≡ wsAfterSeparator (wave-54 L6 RS)', () => {
+  // Neighbour kinds: inline by declared display, inline by UA tag, block by display, block by tag.
+  const kinds: Array<[string, IRProperty[], Record<string, unknown>]> = [
+    ['ib', [{ type: 'Display', data: 'INLINE_BLOCK' }], {}],
+    ['span', [], { sourceTag: 'span' }],
+    ['blk', [{ type: 'Display', data: 'BLOCK' }], {}],
+    ['p', [], { sourceTag: 'p' }],
+  ];
+  // Container declarations: none, flex, grid, inline-flex, pre, pre-line, normal.
+  const containers: IRProperty[][] = [
+    [], [{ type: 'Display', data: 'FLEX' }], [{ type: 'Display', data: 'GRID' }],
+    [{ type: 'Display', data: 'INLINE_FLEX' }], [{ type: 'WhiteSpace', data: 'PRE' }],
+    [{ type: 'WhiteSpace', data: 'PRE_LINE' }], [{ type: 'WhiteSpace', data: 'NORMAL' }],
+  ];
+
+  it('everyMarkerLevelContainerCombination_spacesIffThePredicateSays', () => {
+    let checked = 0; let spaced = 0;
+    for (const [pk, pp, pm] of kinds) for (const [nk, np, nm] of kinds) for (const marked of [true, false]) {
+      for (const [ci, cp] of containers.entries()) {
+        const prev = leaf(comp(`a-${pk}`, pp, { ...pm, ...(marked ? { role: 'ws-after' } : {}) }));
+        const next = leaf(comp(`b-${nk}`, np, nm));
+        const parent = { component: comp(`row-${ci}`, cp), children: [prev, next] } as unknown as ComposedNode;
+        const html = renderToStaticMarkup(<ComponentRenderer node={parent} />);
+        // The character right before `next`'s opening tag: ' ' = separated, '>' = flush.
+        const at = html.lastIndexOf('<', html.indexOf(`data-component-id="b-${nk}"`));
+        const childSpaced = html[at - 1] === ' ';
+        // The predicate on the SAME container styles the child walk passes (ctx.styles).
+        expect(childSpaced, `${pk}${marked ? '*' : ''}>${nk} in container #${ci}`)
+          .toBe(wsAfterSeparator(prev, next, cssOf(cp)) === ' ');
+        checked++; if (childSpaced) spaced++;
+      }
+    }
+    // 4 × 4 × 2 × 7 = 224 combinations, of which only marked inline pairs in
+    // a block/normal container separate: 2 × 2 (inline kinds) × 2 containers.
+    expect(checked).toBe(224);
+    expect(spaced).toBe(8);
+  });
+});
