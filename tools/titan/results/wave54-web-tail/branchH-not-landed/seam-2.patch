+
+const doc = (components: unknown[]): IRDocument =>
+  ({ irVersion: 2, minReaderVersion: 2, components }) as unknown as IRDocument;
+/** The composed host whose id ends with `suffix`. */
+function host(components: unknown[], suffix: string): ComposedNode {
+  const h = composeTree(doc(components)).find((r) => r.component.id.endsWith(suffix));
+  if (!h) throw new Error(`no host ${suffix}`);
+  return h;
+}
+/** -002 with box 4's member or runs replaced. */
+const withBox4Member = (patch: (m: Record<string, unknown>) => Record<string, unknown>) =>
+  DOC002.map((c) => (c.id === 'hyphens__hyphens-out-of-flow-002__4__0-290' ? patch({ ...c }) : c));
+const withBox4Runs = (runs: unknown[]) =>
+  DOC002.map((c) => (c.id === 'wpt__css-text__hyphens__hyphens-out-of-flow-002__4-289'
+    ? { ...c, meta: { ...(c.meta as object), runs } } : c));
+const M4 = { child: 'hyphens__hyphens-out-of-flow-002__4__0' };
+
+// Composed capture constants on (the harness suites' stub-and-reimport pattern).
+let ComponentRenderer: typeof import('../../src/sdui/ComponentRenderer').ComponentRenderer;
+beforeAll(async () => {
+  vi.stubGlobal('window', { location: { search: '?wpt=1&wptComposed=1' } });
+  vi.resetModules();
+  ({ ComponentRenderer } = await import('../../src/sdui/ComponentRenderer'));
+}, 30000);
+afterAll(() => { vi.unstubAllGlobals(); });
+const html = (n: ComposedNode) => renderToStaticMarkup(<ComponentRenderer node={n} />);
+/** The member element's opening-tag prefix (its slot is what the assertions read around). */
+const MEMBER = '<span data-component-id="hyphens__hyphens-out-of-flow-002__';
+
+describe('branch H — bare run text around a mid-word inert member (wave-54 L6 W1)', () => {
+  it('(H-a) boxes 3-6 render their pieces bare, member at its wire slot', () => {
+    const want: Record<string, [string, string]> = {
+      '__3-287': ['h', 'ighway'], '__4-289': ['high', 'way'], '__5-291': ['high', 'way'], '__6-293': ['highwa', 'y'],
+    };
+    for (const [suffix, [p, n]] of Object.entries(want)) {
+      const m = html(host(DOC002, suffix));
+      // `…>P<span member…>abspos</span>N</div>`: bare text on both sides, no wrapper span.
+      expect(m, suffix).toContain(`>${p}${MEMBER}`);
+      expect(m, suffix).toContain(`>abspos</span>${n}</div>`);
+      expect(m, suffix).not.toContain(`<span>${p}</span>`);
+    }
+  });
+
+  it('(H-c) word-edge boxes 2 / 7 and a SPACED split keep the <span> wrapper', () => {
+    expect(html(host(DOC002, '__2-285'))).toContain('<span>highway</span>');
+    expect(html(host(DOC002, '__7-295'))).toContain('<span>highway</span>');
+    expect(html(host(withBox4Runs([{ text: 'high ' }, M4, { text: 'way' }]), '__4-289'))).toContain('<span>high </span>');
+  });
+
+  it('(H-d) -001 box 4 (hyphens: manual) keeps the wrapper', () => {
+    expect(html(host(DOC001_BOX4, '__4-275'))).toContain('<span>high</span>');
+  });
+
+  it('(H-e) a member that could paint keeps the wrapper (alpha 1, a background, an <img>)', () => {
+    const variants: Array<(m: Record<string, unknown>) => Record<string, unknown>> = [
+      (m) => ({ ...m, properties: [{ type: 'Position', data: 'ABSOLUTE' }, { type: 'Color', data: { srgb: { r: 0, g: 0, b: 0, a: 1 }, original: 'black' } }] }),
+      (m) => ({ ...m, properties: [...(m.properties as object[]), { type: 'BackgroundColor', data: { srgb: { r: 1, g: 0, b: 0 }, original: 'red' } }] }),
+      (m) => ({ ...m, meta: { ...(m.meta as object), sourceTag: 'img' } }),
+    ];
+    for (const patch of variants) expect(html(host(withBox4Member(patch), '__4-289'))).toContain('<span>high</span>');
+  });
+
+  it('(H-g) the restated predicate over the 24 census members gives the same 12 trues as Compose', () => {
+    const leaf = (c: Record<string, unknown>) => ({ component: c, children: [] }) as unknown as ComposedNode;
+    const got = MEMBERS24.map((m) => isInertTextMember(leaf(m.component)));
+    expect(got).toEqual(MEMBERS24.map((m) => m.paintInert));
+    expect(got.filter(Boolean)).toHaveLength(12);
+  });
+});
