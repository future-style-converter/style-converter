+// InertSplitBareText.ts — wave-54 lane L6, unit W1, BRANCH H ONLY (seam-2.patch;
+// land it ONLY when the [W-L6] step-0 probe prints `BRANCH H`).
+//
+// WHY (branch H): hyphens-out-of-flow-002 web boxes 4/5 (`high<span abspos>
+// abspos</span>way`, hyphens:auto, 6ch) render as one 26-px line where the
+// ref has `high‐` / `way` (web-out-of-flow-hyphen-box.md §2). Branch H is the
+// step-0 finding that host Chromium hyphenates the RAW markup (V0 / V6 = 46)
+// and the package-default DOM (V2 = 46) but NOT the harness shape (V1 = 26):
+// the harness's per-piece `<span>` wrapper (renderText, the swarm-002 Bug 1
+// shape) is what hides the `high|way` point. The runtime is right there, so
+// the fix stays in the harness: the pieces of such a host render as BARE text
+// nodes, the package default — the member keeps its wire slot (spec 03 §4.1
+// rule 1 intact).
+//
+// REACH: a host whose OWN computed `hyphens` is `auto` (css-text-3 §5.4) and
+// whose wire runs put a paint-inert out-of-flow member BETWEEN two word
+// fragments (no white space on either side). Census (wave53-final): 4 hosts,
+// all in hyphens-out-of-flow-002. The general wrapper question (W2: bare text
+// for all 264 runs hosts) is a BACKLOG item, not this file's.
+//
+// Under branch H the runtime twin (runtimes/web/src/renderer/
+// InertOutOfFlowWordJoin.ts) does not land, so the Compose predicate is
+// restated here (third copy: Compose InertOutOfFlowMember.admits + the
+// InlineRunFold TEXT_MEMBER_TAGS ring).
+
+import type { RenderContext } from '@style-converter/web/renderer/RendererOptions';
+import type { ComposedNode } from './Composer';
+
+/** CSS 2.1 §9.3.1: absolute and fixed take the box out of flow. */
+const OUT_OF_FLOW_POSITIONS: ReadonlySet<string> = new Set(['ABSOLUTE', 'FIXED']);
+/** Compose InlineRunFold TEXT_MEMBER_TAGS: tags whose text carries no UA styling (keeps <img>/<input> out). */
+const TEXT_MEMBER_TAGS: ReadonlySet<string> = new Set(['span', 'time', 'data']);
+/** CSS document white space (css-text-3 §4.1; CSS 2.1 adds form feed). */
+const WHITE_SPACE = /[ \t\n\r\f]/;
+
+/** A JSON-object value (Kotlin `as? JsonObject`). */
+const asObject = (v: unknown): Record<string, unknown> | null =>
+  (v !== null && typeof v === 'object' && !Array.isArray(v) ? (v as Record<string, unknown>) : null);
+/** A JSON primitive's content (Kotlin `contentOrNull`). */
+const primitiveContent = (v: unknown): string | null =>
+  (typeof v === 'string' ? v : (typeof v === 'number' || typeof v === 'boolean') ? String(v) : null);
+
+/** Compose ValueExtractors.extractKeyword: a bare primitive, else `keyword` then `value`. */
+function keywordOf(data: unknown): string | null {
+  const o = asObject(data);
+  return o === null ? primitiveContent(data) : (primitiveContent(o.keyword) ?? primitiveContent(o.value));
+}
+
+/** Compose alphaIsZero: `srgb.a` present, numeric and ≤ 0 (absent alpha = opaque → refuse). */
+function alphaIsZero(data: unknown): boolean {
+  const srgb = asObject(asObject(data)?.srgb);
+  if (srgb === null) return false;
+  const raw = srgb.a;
+  const a = typeof raw === 'number' ? raw
+    : (typeof raw === 'string' && /^[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?$/.test(raw)) ? Number(raw) : NaN;
+  return a <= 0;
+}
+
+/** Compose InertOutOfFlowMember.admits, restated, behind the TEXT tag ring. */
+export function isInertTextMember(member: ComposedNode): boolean {
+  const c = member.component;
+  // The ring first: only no-UA-ink text tags.
+  const tag = c.meta?.sourceTag?.toLowerCase();
+  if (!tag || !TEXT_MEMBER_TAGS.has(tag)) return false;
+  // Structure of its own could paint.
+  if (member.children.length > 0 || (c.meta?.runs?.length ?? 0) > 0 || (c.meta?.decorations?.length ?? 0) > 0) return false;
+  let outOfFlow = false;
+  let transparentInk = false;
+  for (const p of c.properties) {
+    if (p.type === 'Position') {
+      // Out of flow only for absolute/fixed.
+      if (OUT_OF_FLOW_POSITIONS.has(keywordOf(p.data)?.toUpperCase() ?? '')) outOfFlow = true; else return false;
+    } else if (p.type === 'Color') {
+      // Only fully transparent ink is paint-inert.
+      if (alphaIsZero(p.data)) transparentInk = true; else return false;
+    } else if (p.type !== 'Hyphens') {
+      // Anything else could paint or move ink.
+      return false;
+    }
+  }
+  return outOfFlow && transparentInk;
+}
+
+/**
+ * True when this host's text pieces must render as BARE text nodes: its own
+ * `hyphens` is `auto` and its wire runs split a word around a paint-inert
+ * out-of-flow member. False for every other host (the `<span>` stays).
+ */
+export function splitsWordAroundInertOutOfFlow(ctx: RenderContext): boolean {
+  // Only an `auto` host has a dictionary point to lose.
+  if (ctx.styles.hyphens !== 'auto') return false;
+  const runs = ctx.component.meta?.runs;
+  if (!Array.isArray(runs)) return false;
+  for (let i = 1; i + 1 < runs.length; i++) {
+    const [prev, cur, next] = [runs[i - 1], runs[i], runs[i + 1]];
+    // A child entry between two text entries…
+    if (typeof cur?.child !== 'string' || typeof prev?.text !== 'string' || typeof next?.text !== 'string') continue;
+    // …that sits MID-word (no white space on either side of it)…
+    const p = prev.text; const n = next.text;
+    if (p.length === 0 || n.length === 0 || WHITE_SPACE.test(p[p.length - 1]) || WHITE_SPACE.test(n[0])) continue;
+    // …and resolves (authoring key: name first, then id — InlineRuns.ts) to a paint-inert member.
+    const member = ctx.node.children.find((c) => c.component.name === cur.child)
+      ?? ctx.node.children.find((c) => c.component.id === cur.child);
+    if (member && isInertTextMember(member)) return true;
+  }
+  return false;
+}
