+        // abspos-autopos-htb-ltr: 100×100 content box inside 20/5/10/15 borders.
+        val cb = DynamicValueResolver.childContainingBlock(autoposContainer, ContainingBlock(widthPx = 358f), wptCaptureMode = true)
