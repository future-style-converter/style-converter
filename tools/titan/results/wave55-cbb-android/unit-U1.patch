+        val outer = DynamicValueResolver.childContainingBlock(nestedClipOuter, ContainingBlock(widthPx = 358f), wptCaptureMode = true)
+        assertEquals(200f, outer.widthPx)
+        assertEquals(100f, outer.heightPx)
