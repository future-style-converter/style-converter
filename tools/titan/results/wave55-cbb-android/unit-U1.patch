+    @Test
+    fun `CBB the dark stage breadcrumbs a declared content-box and still subtracts`() {
+        // Wave 55 (lane L2, C8): the dark stage keeps the frozen border-box
+        // subtraction even under a DECLARED content-box (every committed
+        // baseline stays byte-identical by construction), and names that
+        // latent inconsistency through PropertyTracker — the house
+        // no-silent-fallthrough rule. Mutation (lane note): delete the
+        // markUnhandled in ContainingBlockBands.subtracts → this row is RED.
+        val tracker = com.styleconverter.runtime.PropertyTracker
+        // A clean tracker so only this row's calls can set the breadcrumb.
+        tracker.reset()
+        // Unset box-sizing on the dark stage: the frozen 180×80, no breadcrumb.
+        val unset = DynamicValueResolver.childContainingBlock(nestedClipOuter, ContainingBlock(widthPx = 358f))
+        assertEquals(180f, unset.widthPx)
+        org.junit.Assert.assertFalse(tracker.isUnhandled(ContainingBlockBands.DARK_STAGE_BREADCRUMB))
+        // Declared content-box on the dark stage: STILL subtracted (180×80)…
+        val declared = nestedClipOuter + prop("BoxSizing", "\"CONTENT_BOX\"")
+        val dark = DynamicValueResolver.childContainingBlock(declared, ContainingBlock(widthPx = 358f))
+        assertEquals(180f, dark.widthPx)
+        assertEquals(80f, dark.heightPx)
+        // …and the breadcrumb names the case (exact string: the tracker key).
+        assertTrue(tracker.isUnhandled("ContainingBlock[dark-stage-content-box-bands]"))
+        // Under WPT capture the same declaration publishes 200×100, no breadcrumb.
+        tracker.reset()
+        val wpt = DynamicValueResolver.childContainingBlock(declared, ContainingBlock(widthPx = 358f), wptCaptureMode = true)
+        assertEquals(200f, wpt.widthPx)
+        org.junit.Assert.assertFalse(tracker.isUnhandled(ContainingBlockBands.DARK_STAGE_BREADCRUMB))
+        // Leave the global tracker clean for the next test class.
+        tracker.reset()
