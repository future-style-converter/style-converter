+        prop("Display", "\"FLEX\""), prop("Position", "\"RELATIVE\""), prop("WritingMode", "\"HORIZONTAL_TB\""),
+        prop("Direction", "\"LTR\""), prop("Width", """{"type":"length","px":100}"""),
+        prop("Height", """{"type":"length","px":100}"""),
