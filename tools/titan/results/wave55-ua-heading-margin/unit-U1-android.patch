@@ -0,0 +1,225 @@
+package com.styleconverter.runtime.spacing
+
+// Wave 55 (lane L4, U1-android) — pins UaPositionedHeadingMargin on the
+// VERBATIM per-test IR of wave54-final (= wave55-open): UAHeadingFaceWire
+// (typography/UAElementFontRuleTest.kt; its constants' sha256 equal the
+// wave54-final files) plus S_11_1_1B_005 below, generated by
+// tools/titan/results/wave55-ua-heading-margin/gen-wire55.py. Each site is
+// replayed root → target through the production decoder + composer
+// (UAHeadingFaceReplay.site), so `preUa` is the seam's ListStyleUaRule list.
+//   • inset-005 / -006 / -011 <h1> → 21.44 — mutation: the painted basis (10.72);
+//   • inset-014 → 17.42 — mutations: em base 16; the 16px-root table (21);
+//   • inset-001 (declares both edges) → SAME list — mutation: drop the per-edge guard;
+//   • capture off → SAME — mutation: ignore `enabled`;
+//   • the in-flow text-decoration-color h3 → SAME — mutation: drop the out-of-flow test;
+//   • s-11-1-1b-005's abspos <p> → SAME, logged — mutation: widen past headings;
+//   • RELATIVE / STICKY, vertical writing mode, unresolvable sizes → SAME;
+//   • the fold verdicts of the four hosts are unchanged by the step.
+// The seam CALL SITE is pinned by UaPositionedHeadingMarginSeamWiringTest,
+// which ships inside seam-1.patch with the hunk it reads (rule 2b).
+
+import com.styleconverter.runtime.core.ir.IRProperty
+import com.styleconverter.runtime.core.renderer.InlineRunPlan
+import com.styleconverter.runtime.typography.UAElementFontRule
+import com.styleconverter.runtime.typography.UAHeadingFaceReplay
+import com.styleconverter.runtime.typography.UAHeadingFaceWire
+import com.styleconverter.runtime.typography.inline.InlineRunFold
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.float
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class UaPositionedHeadingMarginTest {
+
+    /** The four heading hosts (wire, id): three folded targets + the bailing 011. */
+    private val inset005 = UAHeadingFaceWire.INSET_005 to "text-decoration-inset-005__1__0-069"
+    private val inset006 = UAHeadingFaceWire.INSET_006 to "text-decoration-inset-006__1__0-076"
+    private val inset011 = UAHeadingFaceWire.INSET_011 to "text-decoration-inset-011__1__0-095"
+    private val inset014 = UAHeadingFaceWire.INSET_014 to "text-decoration-inset-014__1__0-110"
+
+    /** The seam's pre-UA site of a verbatim (document, id) pair. */
+    private fun site(pair: Pair<String, String>) = UAHeadingFaceReplay.site(pair.first, pair.second)
+
+    /** The step on [s] with the UA face HELD or APPLIED (standsDown), capture on. */
+    private fun step(s: UAHeadingFaceReplay.Site, faceHeld: Boolean, enabled: Boolean = true): List<IRProperty> {
+        // The UA font step first (the seam's order), its face held or applied…
+        val font = UAElementFontRule.apply(s.component._tag, s.own, s.mergedPreUa, standsDown = faceHeld)
+        // …then the margin step on its output, the pre-font list as the em base.
+        return UaPositionedHeadingMargin.apply(s.component._tag, s.own, s.mergedPreUa, font, enabled)
+    }
+
+    /** The single [type] entry's px, asserting there is exactly one. */
+    private fun px(list: List<IRProperty>, type: String): Float {
+        // One entry: first-wins and last-wins readers agree.
+        assertEquals(type, 1, list.count { it.type == type })
+        // The `{"px": m}` leaf the margin readers decode.
+        return list.single { it.type == type }.data.jsonObject.getValue("px").jsonPrimitive.float
+    }
+
+    /** A synthetic element list from (type, JSON) pairs. */
+    private fun props(vararg p: Pair<String, String>) = p.map { (t, j) -> IRProperty(t, Json.parseToJsonElement(j)) }
+
+    @Test
+    fun `inset-005, -006 and -011 - the abspos h1 takes 0_67 x its 32px UA face, face held or applied`() {
+        for (pair in listOf(inset005, inset006, inset011)) {
+            // The verbatim heading's seam site (root → target replay).
+            val s = site(pair)
+            // The verbatim heading declares no margin and no size.
+            assertTrue(s.own.none { it.type.startsWith("Margin") || it.type == "FontSize" })
+            // The held (U1 alone) and the applied (U1 + U2) face.
+            for (held in listOf(true, false)) {
+                val out = step(s, faceHeld = held)
+                // .67 × 2 × 16 on both edges, whether or not the face is painted.
+                assertEquals("${pair.second} held=$held", 21.44f, px(out, "MarginTop"), 1e-3f)
+                assertEquals(21.44f, px(out, "MarginBottom"), 1e-3f)
+            }
+        }
+    }
+
+    @Test
+    fun `inset-014 - the monospace abspos h1 takes 0_67 x 26 (the 13px fixed default)`() {
+        // The face held: the basis must still be the UA-cascade 26px.
+        val out = step(site(inset014), faceHeld = true)
+        // 2em × 13 = 26 → 17.42, not 21.44 (base 16) and not 21 (the root table).
+        assertEquals(17.42f, px(out, "MarginTop"), 1e-3f)
+        assertEquals(17.42f, px(out, "MarginBottom"), 1e-3f)
+    }
+
+    @Test
+    fun `the seam replay's own font step feeds the same margin`() {
+        for (pair in listOf(inset005, inset014)) {
+            val s = site(pair)
+            // Whatever face the seam's gate paints, the UA-cascade basis is the same.
+            val out = UaPositionedHeadingMargin.apply(s.component._tag, s.own, s.mergedPreUa, UAHeadingFaceReplay.seam(s), true)
+            assertEquals(if (pair == inset014) 17.42f else 21.44f, px(out, "MarginTop"), 1e-3f)
+        }
+    }
+
+    @Test
+    fun `inset-001 - the extractor-baked h1 declares both edges and comes back as the SAME list`() {
+        // The anchor: same abspos <h1>, extractor-baked MarginTop / MarginBottom 21.44.
+        val s = UAHeadingFaceReplay.site(UAHeadingFaceWire.INSET_001, "text-decoration-inset-001__1__0-053")
+        val font = UAHeadingFaceReplay.seam(s)
+        // Author (the UA_H1_PROPS bake) wins per edge: identity.
+        assertSame(font, UaPositionedHeadingMargin.apply(s.component._tag, s.own, s.mergedPreUa, font, true))
+    }
+
+    @Test
+    fun `an abspos h1 declaring only MarginTop takes the UA bottom only`() {
+        // Synthetic: the author declares the block-start edge only.
+        val own = props("Position" to "\"ABSOLUTE\"", "MarginTop" to """{"px":5}""")
+        val out = UaPositionedHeadingMargin.apply("h1", own, own, own, true)
+        // The author's top is kept verbatim; one UA bottom is appended.
+        assertEquals(5f, px(out, "MarginTop"), 1e-6f)
+        assertEquals(21.44f, px(out, "MarginBottom"), 1e-3f)
+    }
+
+    @Test
+    fun `capture off - the SAME list`() {
+        // A real carrier, so only the flag can keep the margin out.
+        val s = site(inset005)
+        val font = UAElementFontRule.apply(s.component._tag, s.own, s.mergedPreUa, standsDown = true)
+        // The product path (no WPT capture) is the identity.
+        assertSame(font, UaPositionedHeadingMargin.apply(s.component._tag, s.own, s.mergedPreUa, font, enabled = false))
+    }
+
+    @Test
+    fun `in flow - the text-decoration-color h3 (no margin, no position) is the SAME list`() {
+        val s = UAHeadingFaceReplay.site(UAHeadingFaceWire.TEXT_DECORATION_COLOR, "wpt__css-text-decor__text-decoration-color__0-021")
+        // The verbatim h3 declares nothing: only the out-of-flow test keeps it out.
+        assertTrue(s.own.isEmpty())
+        val font = UAHeadingFaceReplay.seam(s)
+        assertSame(font, UaPositionedHeadingMargin.apply(s.component._tag, s.own, s.mergedPreUa, font, true))
+        // The block-in-inline leaf h1s (in flow, margin 0 declared) too.
+        val leaf = UAHeadingFaceReplay.site(UAHeadingFaceWire.BLOCK_IN_INLINE_015_PRINT, "block-in-inline-015-print__0__0-190")
+        val leafFont = UAHeadingFaceReplay.seam(leaf)
+        assertSame(leafFont, UaPositionedHeadingMargin.apply(leaf.component._tag, leaf.own, leaf.mergedPreUa, leafFont, true))
+    }
+
+    @Test
+    fun `RELATIVE and STICKY headings stay in flow - the SAME list, FIXED fires`() {
+        // In-flow positioning schemes: the §8.3.1 plan's, never this step's.
+        for (position in listOf("RELATIVE", "STICKY", "STATIC")) {
+            val own = props("Position" to "\"$position\"")
+            assertSame(position, own, UaPositionedHeadingMargin.apply("h2", own, own, own, true))
+        }
+        // `fixed` is out of flow too (css-position-3 §2.1): .83 × 1.5 × 16.
+        val fixed = props("Position" to "\"FIXED\"")
+        assertEquals(19.92f, px(UaPositionedHeadingMargin.apply("h2", fixed, fixed, fixed, true), "MarginTop"), 1e-3f)
+    }
+
+    @Test
+    fun `s-11-1-1b-005 - the abspos p is outside the heading scope - the SAME list, logged`() {
+        val s = UAHeadingFaceReplay.site(UaPositionedHeadingWire.S_11_1_1B_005, "css21-errata__s-11-1-1b-005__0-140")
+        // The verbatim abspos <p> (top: 0, no margin): a UA-margin tag, not a heading.
+        assertEquals("p", s.component._tag)
+        // Identity, with the heading-scope breadcrumb.
+        assertSame(s.mergedPreUa, UaPositionedHeadingMargin.apply("p", s.own, s.mergedPreUa, s.mergedPreUa, true))
+        assertTrue(UaPositionedHeadingMargin.hasLogged("tag:p"))
+    }
+
+    @Test
+    fun `a vertical writing mode is the SAME list, logged`() {
+        val own = props("Position" to "\"ABSOLUTE\"")
+        // WritingMode inherits: it arrives through the merged list.
+        val merged = own + props("WritingMode" to "\"VERTICAL_RL\"")
+        assertSame(merged, UaPositionedHeadingMargin.apply("h1", own, merged, merged, true))
+        assertTrue(UaPositionedHeadingMargin.hasLogged("vertical"))
+    }
+
+    @Test
+    fun `author sizes - absolute px is the basis, parent-relative and shorthand-only are logged`() {
+        // 40px declared: .67 × 40 = 26.8 (B3).
+        val px40 = props("Position" to "\"ABSOLUTE\"", "FontSize" to """{"px":40}""")
+        assertEquals(26.8f, px(UaPositionedHeadingMargin.apply("h1", px40, px40, px40, true), "MarginTop"), 1e-3f)
+        // 2em of an unknown parent, and the unexpanded `font`: identity, logged.
+        val em = props("Position" to "\"ABSOLUTE\"", "FontSize" to """{"original":{"type":"length","original":{"v":2,"u":"EM"}}}""")
+        assertSame(em, UaPositionedHeadingMargin.apply("h3", em, em, em, true))
+        assertTrue(UaPositionedHeadingMargin.hasLogged("size:h3"))
+        val font = props("Position" to "\"ABSOLUTE\"", "Font" to "\"bold 20px serif\"")
+        assertSame(font, UaPositionedHeadingMargin.apply("h4", font, font, font, true))
+        assertTrue(UaPositionedHeadingMargin.hasLogged("size:h4"))
+    }
+
+    @Test
+    fun `the fold verdicts of the four hosts are unchanged by the margin step`() {
+        for (pair in listOf(inset005, inset006, inset014, inset011)) {
+            // The site, and its list after the margin step.
+            val s = site(pair)
+            val after = step(s, faceHeld = true)
+            // The fold reads the host list; Margin* is not among its inputs.
+            val plan = InlineRunPlan.resolve(s.component.runs, s.component.children)!!
+            val pre = InlineRunFold.fold(plan.entries, s.component.children!!, s.mergedPreUa, s.component.lang)
+            val post = InlineRunFold.fold(plan.entries, s.component.children!!, after, s.component.lang)
+            // Folded carries the host list it was given, so compare it with the
+            // appended margins put back on the pre side: everything else is equal.
+            val expected = if (pre is InlineRunFold.Outcome.Folded) pre.copy(properties = pre.properties + after.drop(s.mergedPreUa.size)) else pre
+            assertEquals(pair.second, expected, post)
+            // 005 / 006 / 014 fold, 011 bails (its diverging decoration colours).
+            assertEquals(pair != inset011, pre is InlineRunFold.Outcome.Folded)
+        }
+    }
+
+    @Test
+    fun `an untagged or non-margin tag is the SAME list`() {
+        val own = props("Position" to "\"ABSOLUTE\"")
+        // div / span / no tag: the UA sheet declares no block margin.
+        for (tag in listOf(null, "div", "span", "u")) assertSame(own, UaPositionedHeadingMargin.apply(tag, own, own, own, true))
+        assertNull(UaBlockMarginFontBasis.uaBlockMarginEm("div"))
+    }
+}
