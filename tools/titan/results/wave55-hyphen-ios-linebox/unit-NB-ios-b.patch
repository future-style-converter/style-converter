+
+    /// NB-ios-b (CONTINGENCY — lands only when the stage-1 probe prints
+    /// `anchor: group 1 line 1 offset 1` and nothing else; brief §4 / §9 R1):
+    /// the vertical pads around the glyph run. CSS 2.1 §10.8.1 puts half
+    /// the leading above the first line and half below the last; a
+    /// Blink-pinned run instead pads 0 above and 2 × half-leading below,
+    /// so its first baseline stays at the face's raw ascent (DejaVu 16:
+    /// 14.85 → row 15 under either SwiftUI snapping model) while the box
+    /// stays N × L. Every other run keeps the symmetric half-leading.
+    static func verticalPads(halfLeading: CGFloat, blinkPinned: Bool) -> EdgeInsets {
+        // Blink-pinned: no band above the first line, both halves below.
+        if blinkPinned {
+            // The same total band (2 × half), moved under the last line.
+            return EdgeInsets(top: 0, leading: 0, bottom: 2 * halfLeading, trailing: 0)
+        }
+        // Every other run: the symmetric `.padding(.vertical, half)` band.
+        return EdgeInsets(top: halfLeading, leading: 0, bottom: halfLeading, trailing: 0)
+    }
 }
