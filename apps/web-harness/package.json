{
  "name": "web-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vite test harness — renders IR fixtures with @style-converter/web and captures screenshots for the 3-way SSIM comparison.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "copy-ir": "cp ../../out/tmpOutput.json public/ir-components.json",
    "build-fixtures": "node build-fixtures.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@style-converter/web": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.41.0",
    "sharp": "^0.34.5",
    "ssim.js": "^3.5.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.4"
  }
}
