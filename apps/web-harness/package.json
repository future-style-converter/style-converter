{
  "name": "web-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vite test harness — renders IR fixtures with @style-converter/web and captures screenshots for the 3-way SSIM comparison.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "copy-ir": "cp ../../out/tmpOutput.json public/ir-components.json",
    "build-fixtures": "node build-fixtures.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@style-converter/web": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.13.0",
    "sharp": "^0.35.5",
    "ssim.js": "^3.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
