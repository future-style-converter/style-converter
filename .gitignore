# Gradle
.gradle/
build/
gradle-*/
gradle-*.zip
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Runtime
out/
# probe-text-metrics.sh writes its converter output here (repo root)
out_probe/
*.class

# Vite cache (apps/web-harness dev server)
.vite/

# SwiftPM build artifacts (repo root is the StyleConverterRuntime package root)
.build/
.swiftpm/

# Testing artefacts
# ─ per-platform capture folders: regenerated each run by test-all.sh
# ─ HTML report + diffs: regenerated each run
# ─ Xcode project (xcodegen-generated) + build output
# `tools/visual/baseline/` is NOT ignored — commit it when you want to lock
# known-good captures for regression checks via --baseline.
apps/ios-harness/screenshots/
apps/android-harness/screenshots/
apps/web-harness/screenshots/
tools/visual/report/
apps/ios-harness/StyleConverterTest.xcodeproj/
apps/ios-harness/build/
node_modules/
fixtures/perf/
.claude/
# Tier 5 interaction-state captures + report: regenerated by
# `node tools/visual/interaction-states.mjs` whenever the harness runs.
tools/visual/interaction-snapshots/
tools/visual/interaction-report.json
# Tier 5 pre-converted per-fixture IRs: regenerated by
# `npm run build-fixtures` from fixtures/components/*.json.
apps/web-harness/public/fixtures/
# Tier 11 a11y report: regenerated by `node tools/visual/a11y-audit.mjs`.
tools/visual/a11y-report.json
# Tier 12 OS-matrix per-runtime snapshots + report: regenerated by
# `node tools/visual/os-matrix.mjs`.
tools/visual/os-matrix-snapshots/
tools/visual/os-matrix-report.json
# Tier 10 perf bench output: regenerated by `node tools/visual/perf-bench.mjs`.
tools/visual/perf-results.json
# TITAN Phase 0+ — WPT corpus mirror + derived per-test artifacts.
# The corpus is materialised by tools/titan/fetch-wpt.sh and is too
# large to commit (~1.5 GB sparse). The bucket index
# (tools/titan/wpt-buckets.json) IS the durable artifact — see
# docs/reports/TITAN_ARCHITECTURE.md §10 Q5.
tools/wpt/
tools/wpt/refs/
tools/wpt/captures/
fixtures/wpt/

# TITAN run artifacts — 7.8 GB of per-run captures, regenerated by section-runner
tools/titan/runs/
# TITAN investigation scratch notes (agent-session working files)
tools/titan/investigations/
# Regenerated IR payloads (test-all.sh copies these from out/)
apps/android-harness/app/src/main/assets/tmpOutput.json
apps/ios-harness/StyleConverterTest/Resources/tmpOutput.json
apps/web-harness/public/ir-components.json

# Android SDK location — machine-specific, generated by Android Studio / test-all.sh
apps/android-harness/local.properties
