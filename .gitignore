# Vite cache (testing/web dev server)
.vite/

# Testing artefacts
# ─ per-platform capture folders: regenerated each run by test-all.sh
# ─ HTML report + diffs: regenerated each run
# ─ Xcode project (xcodegen-generated) + build output
# `testing/baseline/` is NOT ignored — commit it when you want to lock
# known-good captures for regression checks via --baseline.
testing/iOS/screenshots/
testing/Android/screenshots/
testing/web/screenshots/
testing/report/
testing/iOS/StyleConverterTest.xcodeproj/
testing/iOS/build/
testing/node_modules/
node_modules/
examples/properties/perf/
.claude/
# Tier 5 interaction-state captures + report: regenerated by
# `node testing/interaction-states.mjs` whenever the harness runs.
testing/interaction-snapshots/
testing/interaction-report.json
# Tier 5 pre-converted per-fixture IRs: regenerated by
# `npm run build-fixtures` from examples/properties/components/*.json.
testing/web/public/fixtures/
# Tier 11 a11y report: regenerated by `node testing/a11y-audit.mjs`.
testing/a11y-report.json
# Tier 12 OS-matrix per-runtime snapshots + report: regenerated by
# `node testing/os-matrix.mjs`.
testing/os-matrix-snapshots/
testing/os-matrix-report.json
# Tier 10 perf bench output: regenerated by `node testing/perf-bench.mjs`.
testing/perf-results.json
# TITAN Phase 0+ — WPT corpus mirror + derived per-test artifacts.
# The corpus is materialised by testing/titan/fetch-wpt.sh and is too
# large to commit (~1.5 GB sparse). The bucket index
# (testing/wpt-buckets.json) IS the durable artifact — see
# testing/TITAN_ARCHITECTURE.md §10 Q5.
testing/wpt/
testing/wpt/refs/
testing/wpt/captures/
examples/wpt/

# TITAN run artifacts — 7.8 GB of per-run captures, regenerated by section-runner
testing/titan/runs/
# TITAN investigation scratch notes (agent-session working files)
testing/titan/investigations/
# Regenerated IR payloads (test-all.sh copies these from out/)
testing/Android/app/src/main/assets/tmpOutput.json
testing/iOS/StyleConverterTest/Resources/tmpOutput.json
testing/web/public/ir-components.json
