{
  "components": {
    "globalnav-curtain": {
      "properties": {
        "background": "rgba(232,232,237,.4)",
        "backdrop-filter": "blur(20px)",
        "visibility": "hidden",
        "position": "fixed",
        "opacity": "0",
        "top": "0",
        "right": "0",
        "bottom": "0",
        "left": "0",
        "width": "100%",
        "height": "100%",
        "z-index": "9998",
        "transition": "opacity .32s cubic-bezier(.4,0,.6,1) 80ms,visibility .32s step-end 80ms"
      }
    },
    "globalnav-link-text": {
      "properties": {
        "position": "absolute",
        "clip": "rect(1px,1px,1px,1px)",
        "clip-path": "inset(0 0 99.9% 99.9%)",
        "overflow": "hidden",
        "height": "1px",
        "width": "1px",
        "padding": "0",
        "border": "0"
      }
    },
    "globalnav-bag-badge": {
      "properties": {
        "top": "auto",
        "bottom": "11px",
        "inset-inline-end": "11px",
        "display": "inline-block",
        "position": "absolute",
        "z-index": "1",
        "width": "1.3em",
        "height": "1.3em",
        "box-sizing": "border-box",
        "float": "none",
        "color": "var(--globalnav-badge-text-color)",
        "font-size": "10px",
        "letter-spacing": "-.008em",
        "line-height": "1.3",
        "text-align": "center",
        "transform-origin": "var(--r-globalnav-end)",
        "transform": "scale(0) translate(calc(-7px * var(--r-globalnav-logical-factor)))"
      }
    },
    "globalnav-bag-badge-separator": {
      "properties": {
        "background": "var(--globalnav-badge-background)",
        "width": "1em",
        "height": "100%",
        "position": "absolute",
        "top": "0",
        "inset-inline-end": ".65em",
        "transform": "scaleX(0)",
        "transition": "transform .3s cubic-bezier(.25,.1,.3,1)",
        "transform-origin": "var(--r-globalnav-end)"
      }
    },
    "visuallyhidden": {
      "properties": {
        "position": "absolute",
        "clip": "rect(1px, 1px, 1px, 1px)",
        "clip-path": "inset(0 0 99.9% 99.9%)",
        "overflow": "hidden",
        "height": "1px",
        "width": "1px",
        "padding": "0",
        "border": "0"
      }
    },
    "no-inversion": {
      "properties": {
        "filter": "invert(1)"
      }
    },
    "button": {
      "properties": {
        "font-size": "14px",
        "line-height": "1.2857742857",
        "font-weight": "400",
        "letter-spacing": "-0.016em",
        "font-family": "\"SF Pro Text\",\"SF Pro Icons\",\"Helvetica Neue\",\"Helvetica\",\"Arial\",sans-serif",
        "background": "var(--sk-button-background)",
        "color": "var(--sk-button-color)",
        "backdrop-filter": "var(--sk-button-backdrop-filter)",
        "border-color": "var(--sk-button-border-color)",
        "padding-block": "calc(var(--sk-button-padding-vertical) - var(--sk-button-border-width))",
        "padding-inline": "calc(var(--sk-button-padding-horizontal) - var(--sk-button-border-width))",
        "border-radius": "var(--sk-button-border-radius)",
        "border-style": "solid",
        "border-width": "var(--sk-button-border-width)",
        "width": "var(--sk-button-width)",
        "min-width": "calc(var(--sk-button-min-width-basis) - var(--sk-button-padding-horizontal)*2)",
        "cursor": "pointer",
        "display": "var(--sk-button-display)",
        "box-sizing": "var(--sk-button-box-sizing)",
        "text-align": "center",
        "text-decoration": "none",
        "white-space": "nowrap"
      }
    },
    "tile-wrapper": {
      "properties": {
        "display": "flex",
        "justify-content": "center",
        "position": "relative",
        "width": "100%",
        "min-height": "650px",
        "box-sizing": "border-box",
        "background-color": "#f5f5f7",
        "overflow": "clip",
        "padding": "48px 0 56px"
      }
    },
    "tile-callout": {
      "properties": {
        "color": "#6e6e73",
        "margin-top": "9px",
        "margin-bottom": "-3px"
      }
    },
    "media-gallery-headline": {
      "properties": {
        "font-size": "56px",
        "line-height": "1.0714285714",
        "font-weight": "600",
        "letter-spacing": "-0.005em",
        "font-family": "\"SF Pro Display\",\"SF Pro Icons\",\"Helvetica Neue\",\"Helvetica\",\"Arial\",sans-serif",
        "color": "#000"
      }
    },
    "media-gallery-item": {
      "properties": {
        "position": "absolute",
        "width": "calc(275px + 13px)",
        "height": "100%",
        "display": "flex",
        "justify-content": "center",
        "background-color": "unset",
        "transform-style": "preserve-3d",
        "will-change": "transform"
      }
    },
    "media-gallery-wrapper-link": {
      "properties": {
        "display": "grid",
        "position": "relative",
        "width": "275px",
        "height": "100%",
        "pointer-events": "none",
        "overflow": "hidden",
        "background-color": "#000",
        "text-decoration": "none",
        "z-index": "4",
        "backface-visibility": "hidden",
        "transform": "translateZ(0)"
      }
    },
    "films-media-gallery-bottom-content": {
      "properties": {
        "transform": "translateZ(0)"
      }
    },
    "media-gallery-longnote": {
      "properties": {
        "color": "#f5f5f7",
        "font-size": "21px",
        "line-height": "1.1904761905",
        "font-weight": "400",
        "letter-spacing": ".011em",
        "font-family": "\"SF Pro Display\",\"SF Pro Icons\",\"Helvetica Neue\",\"Helvetica\",\"Arial\",sans-serif",
        "padding-inline-start": "0",
        "text-shadow": "0px 0px 5px rgba(0,0,0,.6)"
      }
    },
    "mothers-day-icons": {
      "properties": {
        "position": "absolute",
        "left": "50%",
        "transform": "translateX(-50%)",
        "pointer-events": "none",
        "overflow": "visible",
        "z-index": "44",
        "width": "2560px",
        "height": "580px"
      }
    },
    "endless-entertainment": {
      "properties": {
        "background-color": "#f5f5f7",
        "padding-top": "53px"
      }
    }
  }
}