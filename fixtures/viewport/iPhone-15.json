{
  "components": {
    "FlexRow": {
      "properties": {
        "width": "360px",
        "height": "60px",
        "padding": "8px",
        "background-color": "#3b82f6",
        "display": "flex",
        "flex-direction": "row",
        "gap": "8px"
      }
    },
    "GridCell": {
      "properties": {
        "width": "360px",
        "height": "80px",
        "background-color": "#10b981",
        "display": "grid",
        "grid-template-columns": "1fr 1fr"
      }
    }
  }
}